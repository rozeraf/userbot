[Unit]
Description=TG userbot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/raf/projects/userbot
EnvironmentFile=/home/raf/projects/userbot/.env
Environment=NODE_ENV=production
ExecStart=/home/raf/.bun/bin/bun run index.ts
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target

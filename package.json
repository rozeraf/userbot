{
  "name": "jarvis-userbot",
  "version": "1.0.0",
  "description": "Jarvis Userbot with LLM commands, local history analysis, and a read-only TUI",
  "type": "module",
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun run --watch index.ts",
    "tui": "bun run tui/index.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "big-integer": "^1.6.52",
    "drizzle-orm": "^0.45.2",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "input": "^1.0.1",
    "react": "^19.2.8",
    "telegram": "^2.22.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "^19.2.18",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}

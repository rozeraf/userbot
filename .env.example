# Telegram MTProto credentials from https://my.telegram.org
TG_API_ID=12345678
TG_API_HASH=replace-me
TG_SESSION=

# Active LLM provider: gemini or cerebras
LLM_PROVIDER=gemini

# Configure at least the active provider. Multiple keys are comma-separated.
GEMINI_API_KEY=replace-me
# GEMINI_API_KEYS=key-1,key-2
GEMINI_MODEL=gemini-2.0-flash

# CEREBRAS_API_KEY=replace-me
# CEREBRAS_API_KEYS=key-1,key-2
CEREBRAS_MODEL=gpt-oss-120b

SYSTEM_PROMPT=
MAX_LLM_PROMPT_GRAPHEMES=30000
SEMANTIC_SEARCH_ENABLED=false
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Local persistence. 0 disables automatic retention cleanup.
DB_PATH=./userbot.db
DB_RETENTION_DAYS=0

# Separates local TUI sockets when several bot instances run on one account.
USERBOT_INSTANCE=default
